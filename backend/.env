APP_NAME="TalentTrackUNC API"
APP_ENV=local
APP_KEY=base64:fdYW80l/LqDREN9tpgz0bglWdQbPjIlZBQueJNEYli0=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

# ── Database (MySQL 8.0 on port 3306) ────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=talenttrack_unc
DB_USERNAME=root
DB_PASSWORD=

# ── Cache / Queue ─────────────────────────────────────────────────────────────
CACHE_STORE=database
QUEUE_CONNECTION=database
SESSION_DRIVER=database
SESSION_LIFETIME=120

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ── Sanctum ───────────────────────────────────────────────────────────────────
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,localhost:5173,127.0.0.1

# ── CORS ──────────────────────────────────────────────────────────────────────
# Add your frontend origin here
FRONTEND_URL=http://localhost:5173

# ── Mail (for temp password delivery) ────────────────────────────────────────
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@unc.edu.ph"
MAIL_FROM_NAME="${APP_NAME}"
